server {
    server_name projectkittygramm.ddns.net;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8080;
    }

    location / {
        root /var/www/kittygram;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /static/ {
        alias /var/www/kittygram/static/;
        expires 30d;
    }

    location /media/ {
        alias /var/www/kittygramm/media/;
        expires 30d;
    }


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/projectkittygramm.ddns.net/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/projectkittygramm.ddns.net/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}


server {
    if ($host = projectkittygramm.ddns.net) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name projectkittygramm.ddns.net;
    listen 80;
    return 404; # managed by Certbot


}
